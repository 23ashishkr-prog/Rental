# Pooled Neon connection string (host contains "-pooler"). Used by the app on Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Random string, at least 16 characters. Signs the login cookie.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# First month that can accrue rent. Each flat starts at the later of this date and its rent_start_date.
# Months before it are shown as already paid. Default when unset: 2026-04-01
LEDGER_START_DATE=2026-04-01
